[0m02:17:38.551274 [debug] [Thread-1 (]: On model.movie_success.trailer_comments_clean: /* {"app": "dbt", "dbt_version": "1.11.8", "profile_name": "default", "target_name": "dev", "node_id": "model.movie_success.trailer_comments_clean"} */

  
    

  create  table "analytics"."public"."trailer_comments_clean__dbt_tmp"
  
  
    as
  
  (
    

WITH RECURSIVE emoji_map_ranked AS (
    SELECT
        emoji,
        replacement,
        ROW_NUMBER() OVER (ORDER BY distinct_comments DESC) AS rn
    FROM "analytics"."public"."emoji_map"
),
total AS (
    SELECT COUNT(*) AS n FROM emoji_map_ranked
),
base AS (
    SELECT
        comment_id,
        tmdb_id,
        text AS original_text,
        text AS clean_text,
        1    AS step
    FROM "analytics"."public"."trailer_comments"
),
recursive_replace AS (
    SELECT b.comment_id, b.tmdb_id, b.original_text, b.clean_text, b.step
    FROM base b

    UNION ALL

    SELECT
        r.comment_id,
        r.tmdb_id,
        r.original_text,
        REPLACE(r.clean_text, e.emoji, ' ' || e.replacement || ' ') AS clean_text,
        r.step + 1 AS step
    FROM recursive_replace r
    JOIN emoji_map_ranked e ON e.rn = r.step
    WHERE r.step <= (SELECT n FROM total)
)
SELECT
    comment_id,
    tmdb_id,
    original_text,
    clean_text
FROM recursive_replace
WHERE step = (SELECT n FROM total) + 1
  );
  
